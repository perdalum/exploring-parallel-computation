Cell[BoxData[
 RowBox[{
  RowBox[{"compiledF", "=", 
   RowBox[{"FunctionCompile", "[", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"Typed", "[", 
       RowBox[{"n", ",", "\"\<Integer64\>\""}], "]"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"sum", "=", "0."}], "}"}], ",", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"sum", "+=", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"Cast", "[", 
              RowBox[{"i", ",", "\"\<Real64\>\""}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", "sum"}]}], "]"}]}], "]"}], "]"}]}], 
