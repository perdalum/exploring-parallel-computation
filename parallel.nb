     RowBox[{"5000000", ",", "8"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Start", " ", "workers", " ", "before", " ", 
    RowBox[{"measuring", "."}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"LaunchKernels", "[", "8", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DistributeDefinitions", "[", "f", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", "[", "1000", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ParallelEvaluate", "[", 
    RowBox[{"f", "[", "1000", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"One", " ", "calculation", " ", "at", " ", "a", " ", "time"}], 
